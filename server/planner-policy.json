{
  "version": 1,
  "maxInputChars": 4000,
  "maxOperations": 20,
  "maxTextChars": 1000,
  "maxClarificationChars": 500,
  "allowedOperations": {
    "create_task": ["title", "notes", "status", "priority", "dueAt", "projectId", "source", "sourceRef", "category", "tags", "parentId"],
    "create_event": ["title", "notes", "startAt", "endAt", "source"],
    "log_progress": ["content", "projectId", "occurredAt", "source"],
    "update_task": ["id", "title", "notes", "status", "priority", "dueAt", "projectId", "source", "sourceRef", "category", "tags", "parentId"],
    "delete_task": ["id"],
    "create_category": ["name"],
    "delete_category": ["name"],
    "create_performance_goal": ["title", "weight", "successCriteria", "dueAt"],
    "create_performance_control": ["goalId", "title", "frequency", "dueAt", "status"],
    "create_performance_initiative": ["goalId", "title", "status", "dueAt", "progress", "baseline", "targetOutcome", "metricAfter"],
    "create_performance_evidence": ["goalId", "controlId", "initiativeId", "occurredAt", "contribution", "outcome", "metricBefore", "metricAfter", "evidenceType", "evidenceRef", "confidentiality"],
    "create_performance_checkpoint": ["title", "dueAt", "status", "requiredOutput"],
    "update_performance_record": ["recordType", "id", "title", "status", "dueAt", "weight", "progress", "successCriteria", "frequency", "baseline", "targetOutcome", "metricAfter", "contribution", "outcome", "metricBefore", "metricAfter", "evidenceType", "evidenceRef", "confidentiality", "requiredOutput"],
    "log_fitness_session": ["plan", "session", "performedAt", "durationMinutes", "sets", "reps", "loadKg", "rpe", "quality", "soreness24", "soreness48", "notes"],
    "log_hike": ["performedAt", "durationMinutes", "distanceKm", "elevationM", "effort", "notes"],
    "update_fitness_profile": ["heightCm", "weightKg"],
    "log_fitness_weight": ["weightKg", "measuredAt"],
    "update_fitness_session": ["id", "soreness24", "soreness48"]
  },
  "allowedStatuses": ["planned", "in-progress", "done", "cancelled"],
  "allowedPriorities": ["low", "medium", "high"],
  "forbiddenOperations": ["delete_event", "modify_github", "run_command", "send_message", "read_secret"],
  "requiresConfirmation": true,
  "testModeWritesData": false
}
